<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoiceCont" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">#05030F</item>
        <item name="android:statusBarColor">#05030F</item>
    </style>

    <!-- Kılavuz ekranı: geri oklu üst çubuk için. -->
    <style name="Theme.VoiceCont.WithBar" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>

    <!-- Cam efektli buton (uzay teması) -->
    <style name="GlassButton" parent="">
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:textColor">#F0ECFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Birincil (mor gradyan) buton -->
    <style name="PrimaryButton" parent="">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
