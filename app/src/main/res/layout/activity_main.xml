<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.voicecont.app.SpaceBackgroundView
        android:id="@+id/spaceBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:shadowColor="#9A82FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="22" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp"
                android:text="@string/subtitle"
                android:textColor="#B9B2E8"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMic"
                style="@style/GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/perm_mic" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOverlay"
                style="@style/GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/perm_overlay" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAccessibility"
                style="@style/GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/perm_accessibility" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_header"
                android:textColor="#8A83BF"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAutoSend"
                style="@style/GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/auto_send" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuide"
                style="@style/GlassButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:text="@string/guide_button" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStart"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_overlay" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="#C9C3F0"
                android:textSize="14sp"
                android:fontFamily="monospace" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
